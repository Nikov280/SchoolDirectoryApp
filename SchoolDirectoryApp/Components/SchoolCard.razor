@using SchoolDirectoryApp.Models
@using SchoolDirectoryApp.Services
@inject AppStateService AppState

<div class="card mb-3 shadow-sm border-0 @(IsSelected ? "ring-primary bg-light" : "")" 
     style="cursor: pointer; transition: transform 0.2s ease-in-out;" 
     @onclick="() => OnSelect.InvokeAsync(School)"
     onmouseover="this.style.transform='scale(1.02)'" 
     onmouseout="this.style.transform='scale(1)'">
    
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            
            <!-- School Name and Favorite Button Container -->
            <div class="d-flex align-items-center">
                
                <!-- Favorite Button -->
                <button type="button" class="btn btn-sm btn-link text-warning p-0 me-2" @onclick="ToggleFavorite" @onclick:stopPropagation="true">
                    @if (AppState.IsFavorite(School.SchoolId))
                    {
                        <!-- Filled Star SVG for Favorites -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                        </svg>
                    }
                    else
                    {
                        <!-- Outline Star SVG for Non-Favorites -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.56.56 0 0 0-.163-.505L1.71 6.745l4.052-.576a.53.53 0 0 0 .393-.288L8 2.223l1.847 3.658a.53.53 0 0 0 .393.288l4.052.575-2.906 2.77a.56.56 0 0 0-.163.506l.694 3.957-3.686-1.894a.5.5 0 0 0-.461 0z"/>
                        </svg>
                    }
                </button>
                
                <h5 class="card-title text-primary fw-bold mb-0">@School.SchoolName</h5>
            </div>

            <!-- School ID Badge -->
            <span class="badge bg-secondary rounded-pill">ID: @School.SchoolId</span>
        </div>
        
        <p class="card-text text-muted small mb-0">
            📍 @School.Address
        </p>
    </div>
</div>

@code {
    [Parameter]
    public School School { get; set; } = new School();

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<School> OnSelect { get; set; }

    protected override void OnInitialized()
    {
        // Subscribe to state changes so the UI updates when a favorite is added/removed
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        // Unsubscribe to prevent memory leaks
        AppState.OnChange -= StateHasChanged;
    }

    private void ToggleFavorite()
    {
        AppState.ToggleFavorite(School.SchoolId);
    }
}